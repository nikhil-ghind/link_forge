APP_NAME=LinkForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.linkforge.example

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- MySQL (RDS) -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=linkforge-db.abc123.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=linkforge
DB_USERNAME=linkforge
DB_PASSWORD=
# Optional comma-separated read replicas used for analytics scans.
DB_READ_HOST=
MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/rds-combined-ca-bundle.pem

# --- Redis (ElastiCache) ---------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=linkforge.abc123.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PERSISTENT=true
REDIS_DB=0
REDIS_LINKS_DB=1
REDIS_CACHE_DB=2

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# --- LinkForge -------------------------------------------------------------
# Host that short links are rendered against (its own Apache vhost).
LINKFORGE_SHORT_DOMAIN=https://lnkf.rg

# random | counter
LINKFORGE_SLUG_STRATEGY=random
LINKFORGE_SLUG_LENGTH=7
LINKFORGE_SLUG_COUNTER_OFFSET=100000000

# Redirect cache-aside tuning (seconds).
LINKFORGE_CACHE_PREFIX=lf
LINKFORGE_CACHE_TTL=86400
LINKFORGE_CACHE_TTL_JITTER=3600
LINKFORGE_CACHE_NEGATIVE_TTL=60

# Click buffering.
LINKFORGE_CLICK_DRAIN_BATCH=2000
LINKFORGE_CLICK_MAX_BUFFER=500000
LINKFORGE_CLICK_DRAIN_INTERVAL=5
LINKFORGE_CLICK_QUEUE=clicks
LINKFORGE_STORE_IP=false
LINKFORGE_IP_HASH_SALT=

# 302 keeps clicks trackable and links re-targetable; 301 does not.
LINKFORGE_REDIRECT_STATUS=302
LINKFORGE_API_RATE_LIMIT=120
